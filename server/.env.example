# Copy to .env for local development. Never commit the real .env.

# "development" locally; Vercel sets production itself.
NODE_ENV=development
PORT=4000

# MongoDB connection string (MongoDB Atlas free tier works).
# Leave empty to run without a database: /api/v1/health then reports "not_configured".
MONGODB_URI=

# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173
